# =============================================================================
# DePINonBNB — .env.example
# Authoritative env reference. SPEC §8 / README.md "Environment Variables".
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Server: networking & access control --------------------------------
PORT=3000

# Comma-separated allowed browser origins. Empty = no CORS header = browser
# clients are blocked. Set to your frontend origin(s) in dev and prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Strong random key gates admin endpoints. Empty = admin routes return 503.
# Generate with:  openssl rand -hex 32
ADMIN_API_KEY=

# When 1, disables the SSRF guard on operator-supplied rpc_endpoint.
# Only flip on for local docker-compose / dev. Leave 0 in production.
ALLOW_PRIVATE_RPC=0

# ---- Server: trusted RPC quorum (ADR-0009) ------------------------------
# Comma-separated quorum. Majority answer is treated as truth. 3+ recommended.
TRUSTED_RPCS=https://bsc-dataseed1.binance.org,https://bsc-dataseed2.binance.org,https://bsc-dataseed3.binance.org

# DEPRECATED — legacy ADR-0005 single endpoint. Set only if you can't use
# TRUSTED_RPCS yet; logs a deprecation warning on boot. Will be removed.
# TRUSTED_RPC=

# ---- Server: storage ----------------------------------------------------
# SQLite DSN (preferred). Use "memory" for in-memory store (tests/dev).
# DATABASE_URL=
# DB_PATH=

# ---- Server: scheduler (ADR-0007) ---------------------------------------
SCHEDULER_ENABLED=true
HEARTBEAT_INTERVAL=5m
CHALLENGE_CHECK_INTERVAL=1m
REWARD_INTERVAL=5m
RPC_WORKERS=50

# ---- Server: rewards (ADR-0008, Phase 5 cron) ---------------------------
# Weekly default per ADR-0008. Set to 0/off/false/disabled/no to disable.
SNAPSHOT_INTERVAL=168h

# ---- Server: observability (Phase 5) ------------------------------------
METRICS_ENABLED=true
LOG_LEVEL=info
# LOG_FORMAT=json   # uncomment for JSON log output

# =============================================================================
# Prover (operator-side CLI). Only needed if you're running cmd/prover.
# =============================================================================

# Operator's wallet private key. NEVER commit.
PROVER_PRIVATE_KEY=

# Operator's local node RPC.
NODE_RPC=http://localhost:8545

# Backend API URL.
DEPIN_API=http://localhost:3000/api

# Self-declared node type. One of:
#   bsc-full | bsc-fast | bsc-archive | opbnb-full | opbnb-fast
NODE_TYPE=bsc-full

# Submit interval in ms (5 min default).
INTERVAL=300000
